{
  "headers": [
    {
      "source": "/home-old",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/((?!robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}